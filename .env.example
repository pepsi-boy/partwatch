# Copy to .env and fill in. Never commit .env.

# Best Buy Products API key (free from https://developer.bestbuy.com)
BESTBUY_API_KEY=
# Leave the key blank to run in demo mode with the mock Best Buy provider.
# Requests per second per Celery worker (Best Buy allows 5/sec per key)
BESTBUY_RATE_LIMIT=4/s

# Docker Compose overrides these two to point at its own containers
DATABASE_URL=postgresql+psycopg://partwatch:partwatch@localhost:5432/partwatch
REDIS_URL=redis://localhost:6379/0

# Email alerts (Gmail: use an app password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Protects write endpoints (POST/PATCH /parts)
ADMIN_TOKEN=

# Scheduling and deal detection
CHECK_INTERVAL_HOURS=3
DEAL_THRESHOLD_PERCENT=10
MIN_SNAPSHOTS_FOR_DEAL=5

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
